PNP_MODE=development
AGENT_ENGINE=mock
# Unset means "localhost", which binds both 127.0.0.1 and ::1. The allowed set is loopback only:
# 127.0.0.1, localhost, ::1.
PNP_HOST=localhost
PNP_PORT=6217
PNP_DATA_DIR=./data

# --- Integration provider (which model/tool/policy path a real, non-mock engine uses) ---
# configured | internal | mock. Unset defaults to "configured" for a real engine and "mock" when
# the selected engine is the development-only mock engine. "internal" is only ever an explicit
# choice, and while it has no implementation that explicit choice refuses to start.
# PNP_INTEGRATION=configured
# Absolute path to a configured-integration profile (models/tools/policy; see
# config/configured.example.json for the shape). Unset means the shipped profile,
# config/competition-profile.json; an explicit absolute path wins.
# PNP_CONFIGURED_PROFILE=C:\path\to\your-private-profile.json
# The shipped profile names these two variables instead of carrying an endpoint or a credential.
# Both are required to start with it: the endpoint must be https (http only on loopback), and the
# Authorization value is read from the environment on every prompt, never stored.
# PNP_MODEL_ENDPOINT=https://your-model-host/v1
# PNP_MODEL_AUTHORIZATION=Bearer your-model-credential
# Deployment-side policy on top of the profile's policy.operations, as a JSON object. Use it to
# put one operation behind an approval without forking the shipped profile.
# PNP_CONFIGURED_POLICY_OVERRIDES={"write":"ask"}

# 1 makes a `model` selection that the profile does not list fail with 403 MODEL_NOT_ALLOWED.
# Unset (the default) maps an unconfigured selection to the profile's first model, publishes a
# `model.resolved` event with resolution "substituted" and warns once: the caller picks those
# identifiers, the profile picks the endpoint, so the substitution widens nothing.
# PNP_MODEL_STRICT=1

# --- OpenCode engine (all optional; unset or empty both mean "use config/engines/opencode.json") ---
# Absolute path to the opencode executable, when it is not in a well-known location.
# PNP_OPENCODE_EXE_PATH=C:\path\to\opencode.exe
# engine-default | ask. Overrides "nativePermissions" in config/engines/opencode.json. "ask" writes
# "permission": {"edit":"ask","bash":"ask"} into the session-private OpenCode config, so the engine
# raises ACP session/request_permission before an edit or a command and the gateway's policy decides
# (a "deny" or "ask" operation in the integration profile is what makes it reach GET /permission).
# Any other value refuses to start (ENGINE_CONFIG_INVALID) rather than silently allowing everything.
# PNP_OPENCODE_NATIVE_PERMISSIONS=ask

# --- Capacity and timeouts (all optional; unset or empty both mean "use the default") ---
# Resident channel cap, 1-64. Raise this if one round opens more concurrently-resident sessions
# than the default before any of them close; least-recently-used channels are evicted at the cap.
# PNP_MAX_RESIDENT_SESSIONS=16
# Wall-clock budget for one prompt run, in ms, 1000-86400000. Raise for tasks/tools that
# legitimately run long (large document conversion, multi-step web research).
# PNP_RUN_TIMEOUT_MS=900000
# Budget for the native process/engine handshake, in ms, 1000-600000. Raise on a machine where
# antivirus scanning or a cold compilation cache makes the first launch slow.
# PNP_OPEN_TIMEOUT_MS=60000
# Grace period given to a run after cancellation before its stop is treated as unproven, in ms,
# 100-300000. Raise if a tool needs more time to flush/close a file (e.g. an Office SaveAs) before
# a hard stop; keep it low to recycle a session quickly between cases.
# PNP_CANCEL_GRACE_MS=15000
# Time to wait for a question/permission reply before it times out (denied with reason TIMEOUT), in
# ms, 1000-600000.
# PNP_INTERACTION_TIMEOUT_MS=45000
# Cross-session requests that may wait for the single execution slot, 1-128. One run executes at a
# time; another session's prompt_async queues in arrival order instead of being refused, and only a
# full queue answers 409 GATEWAY_BUSY (with Retry-After: 5). A second prompt_async for a session
# that is already running or queued is always refused immediately with 409 SESSION_BUSY.
# PNP_RUN_QUEUE_LIMIT=8

# Real credentials belong in the approved private environment, not this file.
