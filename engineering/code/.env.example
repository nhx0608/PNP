# Reference list of every environment variable this gateway reads. Nothing here is required except
# the two model variables. Copy what you need into your shell, or into runtime/local.env (which the
# gateway loads at startup and prints only the NAMES of; see config/local.env.example).
# Real credentials belong in that private file or in the process environment, never in a committed
# settings file.

# --- Engine and bind ---
# opencode | pi. The engine for this run; --engine on the command line means the same thing, and
# giving both different values fails instead of picking one.
AGENT_ENGINE=opencode
# Unset means "localhost", which binds both 127.0.0.1 and ::1. The allowed set is loopback only:
# 127.0.0.1, localhost, ::1.
PNP_HOST=localhost
PNP_PORT=6217
# Session database, instance lock, native session data and process ownership records. Defaults to
# code/data; the launcher points it at code/runtime/data/<engine> so two engines never share one.
PNP_DATA_DIR=./data
# Development-only mock engine. Never set this for a real run.
# PNP_MODE=development

# --- Model service (the only mandatory configuration) ---
# Required. OpenAI-compatible BASE url, ending in /v1 (not /v1/chat/completions).
# https is expected; http is refused unless it is loopback or PNP_ALLOW_HTTP_ENDPOINTS=1.
# PNP_MODEL_ENDPOINT=https://your-model-host/v1
# Required. The model name that endpoint expects. It replaces the identifier in settings.json, so
# any providerID/modelID a client sends in prompt_async still lands on this model.
# PNP_MODEL_ID=your-model-name
# Optional. Sent as "Authorization: Bearer <value>". Read from the environment on every prompt and
# never written to a settings file, a log or the database.
# PNP_MODEL_API_KEY=your-model-credential
# Optional. Extra request headers as a JSON object, e.g. an application id.
# PNP_MODEL_HEADERS={"appid":"your-app-id"}
# Optional. PEM bundle for a private certificate authority. A relative path resolves against code/.
# PNP_MODEL_CA_FILE=./runtime/intranet-ca.pem
# Optional. Allows a plain-http endpoint outside loopback, for both the model service and remote
# MCP servers. An intranet deployment decision, not a default.
# PNP_ALLOW_HTTP_ENDPOINTS=1
# Optional, last resort: turns off TLS verification in the engine process. Prefer PNP_MODEL_CA_FILE.
# PNP_MODEL_TLS_INSECURE=1

# --- Settings, instructions and tools ---
# Unified runtime settings (models, permissions, instructions, mcp.servers). Default:
# config/settings.json. A relative path resolves against code/. `common` is the baseline and
# `cores.<engineId>` overrides only what it declares. Credentials are referenced by variable NAME.
# PNP_SETTINGS=./config/settings.json
# The env file the gateway loads at startup. Default: code/runtime/local.env.
# PNP_LOCAL_ENV_FILE=./runtime/local.env
# Deployment-side policy on top of the settings permissions, as a JSON object of
# operation -> allow|deny|ask. Applied last, and the resulting policy is both what the gateway
# decides with AND what the Engine Pack projects into the engine's native permission block, so this
# variable alone is enough to make an engine raise an approval request.
# PNP_CONFIGURED_POLICY_OVERRIDES={"write":"ask"}
# auto (default) answers an engine's question immediately with its first option and keeps running,
# which is what an unattended evaluation needs. ask makes the run wait for POST /question/{id}/reply.
# PNP_QUESTION_POLICY=auto
# configured | internal | mock. Unset means "configured" for a real engine and "mock" for the
# development-only mock engine. internal has no implementation and refuses to start when chosen.
# PNP_INTEGRATION=configured

# --- Compatibility switches (not the configuration route; here so their existence is documented) ---
# An absolute path to a historical tool-only profile. The shipped settings file is the source of
# models, permissions, instructions and MCP servers; this is read only when it is set explicitly
# and PNP_SETTINGS is not.
# PNP_CONFIGURED_PROFILE=C:\path\to\profile.json
# Deprecated model-only override retained for compatibility; it cannot set permissions.
# PNP_MODEL_SETTINGS=C:\path\to\legacy-model-settings.json
# engine-default | ask. The effective permissions already reach OpenCode's session-private config,
# where a PNP "ask" or "deny" becomes a native "ask" so the gateway's policy decides. "ask" here
# only additionally forces edit/bash into the approval loop; it can never remove a prompt the
# settings require. Any other value refuses to start.
# PNP_OPENCODE_NATIVE_PERMISSIONS=ask

# --- Engine locations (all optional; set one to skip the launcher's install step) ---
# Absolute path to the opencode executable, when it is not in a well-known location.
# PNP_OPENCODE_EXE_PATH=C:\path\to\opencode.exe
# Pi's launch target is a Node entry script, not a native binary: a global npm install only leaves a
# .cmd shim on Windows, which this gateway cannot spawn. Point at the real files instead.
# PNP_PI_ENTRY=C:\path\to\@earendil-works\pi-coding-agent\dist\bundle\cli.js
# Absolute path to a Node executable for the pi process. Defaults to the gateway's own runtime.
# PNP_PI_NODE=C:\Program Files\nodejs\node.exe
# Alternative to the pair above: a single self-contained pi executable. Takes priority when set.
# PNP_PI_EXECUTABLE=C:\path\to\pi.exe
# Optional, JSON array of strings appended verbatim to the pi launch arguments.
# PNP_PI_EXTRA_ARGS=[]
# Optional. "always" passes --approve (trust project-local files); anything else (default) always
# passes --no-approve, matching this gateway's non-interactive operation.
# PNP_PI_APPROVE=never

# --- Launcher (pnp.cmd) ---
# A Node.js 24.19+ installation directory to use instead of the bundled runtime or a download.
# PNP_NODE_HOME=C:\path\to\node-home
# An internal mirror of the official node-v24.19.0-win-x64.zip. The pinned SHA-256 is still verified.
# PNP_NODE_DOWNLOAD_URL=https://your-mirror/node-v24.19.0-win-x64.zip
# Standard npm setting, honoured by the launcher's npm ci and engine install.
# npm_config_registry=https://your-npm-mirror/

# --- Capacity and timeouts (all optional; unset or empty both mean "use the default") ---
# Resident channel cap, 1-64. Raise this if one round opens more concurrently-resident sessions
# than the default before any of them close; least-recently-used channels are evicted at the cap.
# PNP_MAX_RESIDENT_SESSIONS=16
# Wall-clock budget for one prompt run, in ms, 1000-86400000. Raise for tasks/tools that
# legitimately run long (large document conversion, multi-step web research).
# PNP_RUN_TIMEOUT_MS=900000
# Budget for the native process/engine handshake, in ms, 1000-600000. Raise on a machine where
# antivirus scanning or a cold compilation cache makes the first launch slow.
# PNP_OPEN_TIMEOUT_MS=60000
# Grace period given to a run after cancellation before its stop is treated as unproven, in ms,
# 100-300000. Raise if a tool needs more time to flush/close a file (e.g. an Office SaveAs) before
# a hard stop; keep it low to recycle a session quickly between cases.
# PNP_CANCEL_GRACE_MS=15000
# Time to wait for a question/permission reply before it times out (denied with reason TIMEOUT), in
# ms, 1000-600000. Only reached when a reply is actually awaited.
# PNP_INTERACTION_TIMEOUT_MS=45000
# Cross-session requests that may wait for the single execution slot, 1-128. One run executes at a
# time; another session's prompt_async queues in arrival order instead of being refused, and only a
# full queue answers 409 GATEWAY_BUSY (with Retry-After: 5). A second prompt_async for a session
# that is already running or queued is always refused immediately with 409 SESSION_BUSY.
# PNP_RUN_QUEUE_LIMIT=8
