PNP_MODE=development
AGENT_ENGINE=mock
PNP_HOST=localhost
PNP_PORT=6217
PNP_DATA_DIR=./data

# --- Unified runtime settings (models + permissions + per-Core overrides) ---
# Default file: config/settings.json. Set an absolute path to keep deployment settings outside the repository.
# PNP_SETTINGS=C:\path\to\settings.json
# Runtime endpoint/credentials referenced by settings.json. Never commit real values.
# PNP_MODEL_ENDPOINT=https://your-model-host/v1
# PNP_MODEL_AUTHORIZATION=Bearer your-model-credential
# PNP_HIS_MODEL_ENDPOINT=https://your-approved-ai-gateway/v1
# PNP_HIS_AUTHORIZATION=Bearer your-api-key
# Set to 1 when testing real models so an unknown model ID fails instead of using the effective default.
# PNP_MODEL_STRICT=1

# --- Integration provider (tools + compatibility surfaces) ---
# configured | internal | mock. Real engines default to configured.
# PNP_INTEGRATION=configured
# Optional absolute path to a configured-integration profile. The shipped profile is tool-only; model and
# permission settings belong in PNP_SETTINGS. Existing explicit profiles with inline models/policy remain
# compatible when PNP_SETTINGS is not explicitly supplied.
# PNP_CONFIGURED_PROFILE=C:\path\to\your-private-profile.json
# Deprecated model-only override retained for compatibility. New deployments should use PNP_SETTINGS.
# PNP_MODEL_SETTINGS=C:\path\to\legacy-model-settings.json
# Final deployment-side policy override JSON, applied after common/Core settings permissions.
# PNP_CONFIGURED_POLICY_OVERRIDES={"write":"ask"}

# --- OpenCode engine ---
# PNP_OPENCODE_EXE_PATH=C:\path\to\opencode.exe
# Compatibility/diagnostic force-ask switch. Settings are the primary permission source; "ask" additionally
# forces OpenCode edit/bash through the ACP permission loop. "engine-default" adds no extra prompts.
# PNP_OPENCODE_NATIVE_PERMISSIONS=ask

# --- Capacity and timeouts ---
# PNP_MAX_RESIDENT_SESSIONS=16
# PNP_RUN_TIMEOUT_MS=900000
# PNP_OPEN_TIMEOUT_MS=60000
# PNP_CANCEL_GRACE_MS=15000
# PNP_INTERACTION_TIMEOUT_MS=45000
# PNP_RUN_QUEUE_LIMIT=8

# Real credentials belong in the approved private environment, never in committed settings files.
