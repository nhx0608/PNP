PNP_MODE=development
AGENT_ENGINE=mock
# Unset means "localhost", which binds both 127.0.0.1 and ::1. The allowed set is loopback only:
# 127.0.0.1, localhost, ::1.
PNP_HOST=localhost
PNP_PORT=6217
PNP_DATA_DIR=./data

# --- Unified runtime settings (models + permissions + per-Core overrides) ---
# Default file: config/settings.json. Set an ABSOLUTE path to keep deployment settings outside the
# repository. The file is the model and permission source for every Agent Core: `common` is the
# baseline and `cores.<engineId>` overrides only what it declares. It names credentials by
# environment variable NAME and never carries a value.
# PNP_SETTINGS=C:\path\to\settings.json
# Runtime endpoint/credentials referenced by settings.json. Never commit real values. The endpoint
# must be https (http only on loopback), and the Authorization value is read from the environment on
# every prompt, never stored. A variable the effective default model names but the environment does
# not set refuses to start with MODEL_ENVIRONMENT_MISSING, listing the variable names only.
# PNP_MODEL_ENDPOINT=https://your-model-host/v1
# PNP_MODEL_AUTHORIZATION=Bearer your-model-credential
# PNP_HIS_MODEL_ENDPOINT=https://your-approved-ai-gateway/v1
# PNP_HIS_AUTHORIZATION=Bearer your-api-key
# 1 makes a `model` selection that the effective catalog does not list fail with 403
# MODEL_NOT_ALLOWED. Unset (the default) maps an unconfigured selection to the effective default
# model, publishes a `model.resolved` event with resolution "substituted" and warns once: the caller
# picks those identifiers, the settings pick the endpoint, so the substitution widens nothing.
# PNP_MODEL_STRICT=1

# --- Integration provider (tools + compatibility surfaces) ---
# configured | internal | mock. Unset defaults to "configured" for a real engine and "mock" when
# the selected engine is the development-only mock engine. "internal" is only ever an explicit
# choice, and while it has no implementation that explicit choice refuses to start.
# PNP_INTEGRATION=configured
# Absolute path to a configured-integration profile. The shipped profile
# (config/competition-profile.json) is tool-only; model and permission settings belong in
# PNP_SETTINGS. Existing explicit profiles with inline models/policy remain compatible when
# PNP_SETTINGS is not explicitly supplied, and are then read instead of the settings file.
# PNP_CONFIGURED_PROFILE=C:\path\to\your-private-profile.json
# Deprecated model-only override retained for compatibility. It cannot set permissions; new
# deployments should use PNP_SETTINGS.
# PNP_MODEL_SETTINGS=C:\path\to\legacy-model-settings.json
# Deployment-side policy on top of the settings permissions, as a JSON object of
# operation -> allow|deny|ask. Use it to put one operation behind an approval without editing the
# settings file. It is applied last, at load time, and the resulting policy is what the gateway
# decides with AND what the Engine Pack projects into the engine's native permission block through
# the IntegrationContext -- so this variable alone is enough to make an engine raise the request.
# Invalid JSON or an unsupported value refuses to start.
# PNP_CONFIGURED_POLICY_OVERRIDES={"write":"ask"}

# --- OpenCode engine (all optional; unset or empty both mean "use config/engines/opencode.json") ---
# Absolute path to the opencode executable, when it is not in a well-known location.
# PNP_OPENCODE_EXE_PATH=C:\path\to\opencode.exe
# engine-default | ask. Compatibility switch, kept for historical fixtures; it is not the
# configuration route. The effective permissions already reach the session-private OpenCode config,
# where a PNP "ask" or "deny" is written as native "ask" so the engine raises ACP
# session/request_permission and the gateway's policy decides. "ask" here additionally forces
# "permission": {"edit":"ask","bash":"ask"} on; it can only add prompts, never remove one the
# settings require. Any other value refuses to start (ENGINE_CONFIG_INVALID) rather than silently
# allowing everything.
# PNP_OPENCODE_NATIVE_PERMISSIONS=ask

# --- Pi engine (real `pi` CLI is never bundled with this repo; you must install and point at
# it yourself on every machine, see docs/engines/pi.md "B01"/"B08") ---
# `npm install -g --ignore-scripts @earendil-works/pi-coding-agent` only installs a Windows
# `.cmd` shim, which this gateway cannot spawn directly; point at the real files instead. Find
# them under `npm root -g` (typically `%APPDATA%\npm\node_modules\@earendil-works\pi-coding-agent`).
# Absolute path to a Node executable. Defaults to this gateway's own process.execPath (fine on
# most machines; only set this if you need a different Node for the pi process specifically).
# PNP_PI_NODE=C:\Program Files\nodejs\node.exe
# Absolute path to the pi-coding-agent CLI entry script (dist/bundle/cli.js under the package
# printed by `npm root -g`). Required together with PNP_PI_NODE unless PNP_PI_EXECUTABLE is set.
# PNP_PI_ENTRY=C:\Users\you\AppData\Roaming\npm\node_modules\@earendil-works\pi-coding-agent\dist\bundle\cli.js
# Alternative to PNP_PI_NODE/PNP_PI_ENTRY: an absolute path to a single self-contained pi
# executable (e.g. a pkg-built .exe), if you have one. Takes priority when both are set.
# PNP_PI_EXECUTABLE=C:\path\to\pi.exe
# Optional, JSON array of strings appended verbatim to the pi launch arguments.
# PNP_PI_EXTRA_ARGS=[]
# Optional. "always" passes --approve (trust project-local files); anything else (default) always
# passes --no-approve, matching this gateway's non-interactive operation.
# PNP_PI_APPROVE=never

# --- Capacity and timeouts (all optional; unset or empty both mean "use the default") ---
# Resident channel cap, 1-64. Raise this if one round opens more concurrently-resident sessions
# than the default before any of them close; least-recently-used channels are evicted at the cap.
# PNP_MAX_RESIDENT_SESSIONS=16
# Wall-clock budget for one prompt run, in ms, 1000-86400000. Raise for tasks/tools that
# legitimately run long (large document conversion, multi-step web research).
# PNP_RUN_TIMEOUT_MS=900000
# Budget for the native process/engine handshake, in ms, 1000-600000. Raise on a machine where
# antivirus scanning or a cold compilation cache makes the first launch slow.
# PNP_OPEN_TIMEOUT_MS=60000
# Grace period given to a run after cancellation before its stop is treated as unproven, in ms,
# 100-300000. Raise if a tool needs more time to flush/close a file (e.g. an Office SaveAs) before
# a hard stop; keep it low to recycle a session quickly between cases.
# PNP_CANCEL_GRACE_MS=15000
# Time to wait for a question/permission reply before it times out (denied with reason TIMEOUT), in
# ms, 1000-600000.
# PNP_INTERACTION_TIMEOUT_MS=45000
# Cross-session requests that may wait for the single execution slot, 1-128. One run executes at a
# time; another session's prompt_async queues in arrival order instead of being refused, and only a
# full queue answers 409 GATEWAY_BUSY (with Retry-After: 5). A second prompt_async for a session
# that is already running or queued is always refused immediately with 409 SESSION_BUSY.
# PNP_RUN_QUEUE_LIMIT=8

# Real credentials belong in the approved private environment, never in committed settings files.
