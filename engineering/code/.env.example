PNP_MODE=development
AGENT_ENGINE=mock
PNP_HOST=localhost
PNP_PORT=6217
PNP_DATA_DIR=./data

# --- Integration provider ---
# configured | internal | mock. Real engines default to configured.
# PNP_INTEGRATION=configured
# Optional absolute path to a full configured-integration profile (models/tools/policy).
# Existing custom profiles with inline models remain supported.
# PNP_CONFIGURED_PROFILE=C:\path\to\your-private-profile.json

# --- Shared model settings (common to every real Agent Core) ---
# Default file: config/model-settings.json.
# Set an absolute path here to keep model settings outside the repository. This overrides the
# model list for configured integration without changing Engine-specific configuration.
# PNP_MODEL_SETTINGS=C:\path\to\model-settings.json
# The shipped model-settings.json references environment variables instead of storing endpoint or credentials.
# Compatibility default model:
# PNP_MODEL_ENDPOINT=https://your-model-host/v1
# PNP_MODEL_AUTHORIZATION=Bearer your-model-credential
# HIS models already listed in config/model-settings.json:
# PNP_HIS_MODEL_ENDPOINT=https://your-approved-ai-gateway/v1
# PNP_HIS_AUTHORIZATION=Bearer your-api-key
# Set to 1 when testing real models so an unknown model ID fails instead of falling back to default.
# PNP_MODEL_STRICT=1

# Deployment-side policy override JSON.
# PNP_CONFIGURED_POLICY_OVERRIDES={"write":"ask"}

# --- OpenCode engine ---
# PNP_OPENCODE_EXE_PATH=C:\path\to\opencode.exe
# PNP_OPENCODE_NATIVE_PERMISSIONS=ask

# --- Capacity and timeouts ---
# PNP_MAX_RESIDENT_SESSIONS=16
# PNP_RUN_TIMEOUT_MS=900000
# PNP_OPEN_TIMEOUT_MS=60000
# PNP_CANCEL_GRACE_MS=15000
# PNP_INTERACTION_TIMEOUT_MS=45000
# PNP_RUN_QUEUE_LIMIT=8

# Real credentials belong in the approved private environment, never in committed settings files.
