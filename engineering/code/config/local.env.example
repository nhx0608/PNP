# Copy this file to engineering/code/runtime/local.env and fill in the placeholders.
# runtime/ is git-ignored. The gateway loads this file at startup (whatever starts it: pnp.cmd,
# gateway.cmd or npm start) and prints only the NAMES it applied, never a value. A variable that is
# already set in the environment wins over this file.

# Required. The chat-completions endpoint of the model service.
PNP_MODEL_ENDPOINT=<https://model-endpoint/v1/chat/completions>
# Required. The model name that endpoint expects; it replaces the identifier in settings.json.
PNP_MODEL_ID=<model-name>

# Optional. Sent as "Authorization: Bearer <value>".
# PNP_MODEL_API_KEY=<api-key>
# Optional. Extra request headers as a JSON object, for example an application id.
# PNP_MODEL_HEADERS={"appid":"<appid>"}
# Optional. PEM bundle for a private certificate authority; a relative path is resolved
# against engineering/code/.
# PNP_MODEL_CA_FILE=<path-to-ca-bundle.pem>

# Optional. Only when the endpoint speaks plain HTTP outside loopback.
# PNP_ALLOW_HTTP_ENDPOINTS=1

# Optional deployment overrides:
# PNP_DATA_DIR=<data-directory>
# PNP_CONFIGURED_POLICY_OVERRIDES={"write":"ask","bash":"ask"}
# PNP_QUESTION_POLICY=ask

# Optional corporate mirrors. Standard npm_config_registry is honored by npm ci and engine install.
# npm_config_registry=<https://npm-registry/>
# PNP_NODE_DOWNLOAD_URL=<https://mirror/node-v24.19.0-win-x64.zip>

# If Node.js 24.19+ is already installed in a non-standard directory, use this instead of downloading.
# PNP_NODE_HOME=<path-to-node-home>
