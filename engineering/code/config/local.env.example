# Copy this file to engineering/code/runtime/local.env.
# runtime/ is git-ignored. pnp.cmd auto-loads it and never prints secret values.

PNP_SETTINGS=config/settings.his.example.json
PNP_HIS_MODEL_ENDPOINT=https://<your-internal-ai-gateway>/v1
PNP_HIS_AUTHORIZATION=Bearer <your-api-key>
PNP_MODEL_STRICT=1

# Optional deployment overrides:
# PNP_DATA_DIR=D:\pnp-data
# PNP_CONFIGURED_POLICY_OVERRIDES={"write":"ask","bash":"ask"}

# Optional corporate mirrors. Standard npm_config_registry is honored by npm ci and engine install.
# npm_config_registry=https://<your-internal-npm-registry>/
# PNP_NODE_DOWNLOAD_URL=https://<your-internal-mirror>/node-v24.19.0-win-x64.zip

# If Node.js 24.19+ is already installed in a non-standard directory, use this instead of downloading.
# PNP_NODE_HOME=D:\tools\node-v24.19.0-win-x64
