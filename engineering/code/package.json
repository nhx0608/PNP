{
  "name": "pnp-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "gateway": "dist/main.js"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "node scripts/test.mjs unit",
    "test:contract": "node scripts/test.mjs contract",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:strip-only": "node scripts/strip-only-check.mjs",
    "check:ps-encoding": "node scripts/check-powershell-encoding.mjs",
    "check": "npm run typecheck && npm test && npm run test:contract && npm run check:boundaries && npm run check:strip-only && npm run check:ps-encoding",
    "doctor": "node scripts/doctor.mjs",
    "release:check": "node scripts/release-check.mjs",
    "dependencies:freeze": "node scripts/freeze-dependencies.mjs",
    "foundation:check": "node scripts/foundation-check.mjs",
    "e2e": "node scripts/e2e/ci-smoke.mjs",
    "recover": "node scripts/recover.mjs",
    "diagnostics": "node scripts/export-diagnostics.mjs",
    "verify:manifest": "node ../VERIFY.mjs",
    "refresh-manifest": "node scripts/refresh-manifest.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sinclair/typebox": "0.34.41",
    "csv-parse": "7.0.2",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.11.0",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.8.3"
  }
}
