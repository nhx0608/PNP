    {
      "name": "1. 会话生命周期",
      "item": [
        {
          "name": "POST /session  建会话",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{base}}/session",
              "host": [
                "{{base}}"
              ],
              "path": [
                "session"
              ]
            },
            "description": "directory 必填、必须绝对路径、不存在会自动创建。返回的 id 会自动存到 {{sessionId}}。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"office_014\",\n  \"directory\": \"D:\\test_data\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 把新建会话的 id 存进环境变量，后面的请求直接用 {{sessionId}}",
                  "if (pm.response.code === 200) { pm.environment.set('sessionId', pm.response.json().id); }",
                  "pm.test('200 且返回 id/status', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('id');",
                  "  pm.expect(pm.response.json().status).to.be.oneOf(['idle','busy']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /session/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/session/{{sessionId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "session",
                "{{sessionId}}"
              ]
            },
            "description": "含 message_count"
          }
        },
        {
          "name": "GET /session/status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/session/status",
              "host": [
                "{{base}}"
              ],
              "path": [
                "session",
                "status"
              ]
            },
            "description": "{ses_xxx: {type:'idle'|'busy'}}"
          }
        },
        {
          "name": "DELETE /session/{id}",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base}}/session/{{sessionId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "session",
                "{{sessionId}}"
              ]
            },
            "description": "只删网关记录与引擎会话数据，不删产物"
          }
        }
      ]
    },
    {
      "name": "2. 下发任务与取轨迹",
      "item": [
        {
          "name": "POST /session/{id}/prompt_async  发任务",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{base}}/session/{{sessionId}}/prompt_async",
              "host": [
                "{{base}}"
              ],
              "path": [
                "session",
                "{{sessionId}}",
                "prompt_async"
              ]
            },
            "description": "会一直阻塞到本轮全部结束（含所有工具调用），默认上限 15 分钟。请把 Postman 的 Request timeout 调到 900000ms，否则客户端会先超时。model 填任何值都会映射到配置的模型。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parts\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"请在 D:\\test_data 目录下创建 demo.txt，内容写：网关连通性验证 OK。然后告诉我文件的绝对路径。\"\n    }\n  ],\n  \"model\": {\n    \"providerID\": \"any\",\n    \"modelID\": \"any\"\n  },\n  \"agent\": \"assistant\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 204 = 本轮（含所有工具调用）全部结束。这个请求会阻塞，Postman 超时请设为 900000ms。",
                  "pm.test('204 No Content', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /session/{id}/message  完整轨迹",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/session/{{sessionId}}/message",
              "host": [
                "{{base}}"
              ],
              "path": [
                "session",
                "{{sessionId}}",
                "message"
              ]
            },
            "description": "评测方判完成用的就是这个。测试脚本已按赛题 8.4 规则断言。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 赛题 8.4 完成规则：最后一条 assistant + finish=stop + parts 含 step-finish",
                  "const msgs = pm.response.json();",
                  "const last = msgs[msgs.length - 1];",
                  "pm.test('最后一条是 assistant', () => pm.expect(last.role).to.eql('assistant'));",
                  "pm.test('info.finish = stop', () => pm.expect(last.info.finish).to.eql('stop'));",
                  "pm.test('含 step-finish', () => pm.expect(last.parts.some(p => p.type === 'step-finish')).to.be.true);",
                  "console.log('工具调用:', msgs.flatMap(m => (m.tool_calls||[]).map(c => c.name)).join(', ') || '(无)');"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /session/{id}/abort  中止",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base}}/session/{{sessionId}}/abort",
              "host": [
                "{{base}}"
              ],
              "path": [
                "session",
                "{{sessionId}}",
                "abort"
              ]
            },
            "description": "返回 {ok:true}；被中止那次 prompt_async 返回 204，轨迹最后 info.finish='cancelled'。/stop 是等价路径。",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
